# Copy to backend/.env (or export in your shell).
#
# DEFAULT = LIVE extraction: Mistral OCR + OpenAI. Set the two keys below and it
# runs live. If a key is missing the app still boots and automatically falls
# back to the offline extractor (so the demo / tests keep working with no keys).

# ---- Login account (REQUIRED — the app fails CLOSED without it) -----------
# One operator account, checked at sign-in; the app then issues a token that is
# valid for AUTH_TOKEN_TTL_HOURS (24h = one working day) and asks for the
# password again after that. With no username/password configured nobody can
# sign in and every API route answers 401 — a deployment that skipped this step
# is visibly broken rather than quietly serving importers' invoices to the
# whole network.
EASYCUSTOMS_AUTH_USERNAME=your_login_username_here
EASYCUSTOMS_AUTH_PASSWORD=your_login_password_here
# HMAC key that signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset = a random key per process, i.e. every restart (including each
# `uvicorn --reload`) signs everyone out. Changing it also signs everyone out.
EASYCUSTOMS_AUTH_SECRET=your_random_64_hex_secret_here
EASYCUSTOMS_AUTH_TOKEN_TTL_HOURS=24
# Whether the session cookie carries `Secure`: auto | always | never.
#
# SET THIS TO `always` ON ANY DEPLOYMENT REACHED OVER HTTPS. `auto` asks the
# request, and a reverse proxy that terminates TLS and forwards plain http
# makes the request look like http even though the browser is on https — the
# cookie then goes out without `Secure` and one downgraded request puts the
# session token on the wire in clear. `never` is plain-http LAN only.
EASYCUSTOMS_SESSION_COOKIE_SECURE=auto
# Ceiling on a whole request body, refused at the boundary before anything
# parses it. Blank/0 derives it from MAX_UPLOAD_MB (double, 64 MB floor),
# which is what a legitimate multi-photo document set needs.
EASYCUSTOMS_MAX_REQUEST_MB=0

# ---- Live extraction keys (REQUIRED for live mode) ------------------------
EASYCUSTOMS_MISTRAL_API_KEY=your_mistral_key_here     # or set MISTRAL_API_KEY
EASYCUSTOMS_LLM_API_KEY=your_openai_key_here          # or set OPENAI_API_KEY

# ---- Providers ------------------------------------------------------------
EASYCUSTOMS_OCR_PROVIDER=mistral            # mistral (default) | offline
EASYCUSTOMS_EXTRACTION_PROVIDER=openai      # openai (default) | langroid | offline
EASYCUSTOMS_LLM_MODEL=gpt-4o-mini           # any structured-output-capable model
EASYCUSTOMS_MISTRAL_OCR_MODEL=mistral-ocr-latest
EASYCUSTOMS_EXTRACTION_MAX_REPAIR_ROUNDS=2  # evidence/schema repair attempts

# ---- Supabase (multi-user cutover, NOT WIRED YET) --------------------------
# Nothing in the backend reads these yet — they are the names the auth cutover
# will use (frontend: URL + publishable key; backend: URL + secret key).
# Kept commented so nobody configures a protection that does not exist.
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_key_here"
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_KEY="sb_secret_your_key_here"

# ---- Speed / concurrency ---------------------------------------------------
# Global cap on concurrent LLM calls, shared across all documents and page
# windows (one OpenAI tokens-per-minute budget). Lower it if your account's
# TPM limit is tight; 429s are retried with backoff either way. A document
# under a time budget also gets ONE reserved slot on top of this, so undeadlined
# work can never starve it into aborting.
EASYCUSTOMS_LLM_CONCURRENCY=4
EASYCUSTOMS_LLM_TIMEOUT_SECONDS=180         # per LLM request (SDK retries disabled)
EASYCUSTOMS_MISTRAL_OCR_TIMEOUT_SECONDS=120 # per Mistral OCR HTTP call
# Pages per LLM window. Packing lists use the smaller one: dense tables whose
# rows rarely straddle a page break, so wide windows mostly re-send context.
EASYCUSTOMS_EXTRACTION_CHUNK_PAGE_SIZE_PACKING=2
# Packing extraction time budget: slower than this -> the rows extracted so far
# are kept and flagged PARTIAL, and unextracted items fall back to the
# quantity-proportional allocation + reviewer warning (4 min default)
EASYCUSTOMS_PACKING_EXTRACTION_BUDGET_SECONDS=240
# Fast tier for mechanical row-extraction windows (first attempt); repair
# rounds escalate to the primary model. Unset = single-model mode.
OPENAI_REASONING_FALLBACK_MODEL=gpt-5.4-mini

# ---- Persistence ----------------------------------------------------------
# Default is a local SQLite file, which builds and updates itself at startup —
# no migration command, nothing to run.
# For Postgres, the schema is MIGRATED, not auto-built: the app refuses to start
# unless the database is at the alembic head, because create_all cannot ALTER an
# existing table and would leave a later column silently missing. After setting
# the URL below, run:  cd backend && alembic upgrade head
# (A Postgres database that predates migrations: alembic stamp fa843d18c61e first.)
# EASYCUSTOMS_DATABASE_URL=postgresql+psycopg://easycustoms:easycustoms@localhost:5432/easycustoms

# ---- Who holds the accounts ------------------------------------------------
# local (default): the single operator account in AUTH_USERNAME/AUTH_PASSWORD
# above. One account, one password, no registration — right for a broker's own
# machine, and why this app runs with no external service.
# supabase: Supabase Auth. MANY accounts, each with its own id, and the only
# setting under which this app is multi-user at all.
#
# Sign-in is proxied SERVER-side, so the SPA keeps its same-origin HttpOnly
# cookie (which is what makes the evidence iframe and the download links work).
# Only the ANON / publishable key belongs here — never the service-role key.
#
# SWITCHING PROVIDER CHANGES WHO OWNS EXISTING JOBS. Under local, owner_key is
# the operator's NAME; under supabase it is their user id. Jobs owned by a
# principal that no longer signs in are visible to nobody, so remap them once at
# cutover:
#     cd backend && python scripts/reassign_job_owner.py --list
#     cd backend && python scripts/reassign_job_owner.py --from <name> --to <uuid> --apply
# EASYCUSTOMS_AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_publishable_key_here

# ---- Where uploaded documents live ----------------------------------------
# local (default): a directory on this machine. Right for a laptop or a single
# server, and why the app needs no cloud account to run.
# s3: an S3 bucket — REQUIRED for more than one API instance, and for queue mode
# on separate machines. A local directory is not shared, so the instance that
# did not receive an upload has no such file (the evidence panel answers 410
# depending on which instance the load balancer picked), and a worker on another
# machine has nothing to OCR at all.
#
# Safe to turn on with documents already stored: keys record where they live, so
# existing local documents stay readable. Not reversible in the other direction.
# Credentials: prefer an EC2/ECS task role; s3:GetObject/PutObject/DeleteObject
# on the bucket. Encryption belongs on the bucket policy (SSE-KMS).
# EASYCUSTOMS_STORAGE_BACKEND=s3
# EASYCUSTOMS_S3_BUCKET=easycustoms-documents
# EASYCUSTOMS_S3_PREFIX=prod/
# EASYCUSTOMS_S3_REGION=ap-south-1

# ---- Behind a reverse proxy / load balancer -------------------------------
# How many proxies of YOURS sit in front of this app. Decides where the caller's
# real IP is read from for the login throttle.
#
#   0 (default)  nothing trusted in front; X-Forwarded-For is ignored entirely
#   1            one reverse proxy or load balancer (Caddy, nginx, an ALB)
#   2            e.g. CloudFront in front of an ALB
#
# NOT optional behind a proxy. At 0, every request appears to come from the
# proxy, so all callers share ONE throttle bucket: 10 failed sign-ins from
# anywhere lock out every user, and an unauthenticated attacker can trigger that
# deliberately. Set too HIGH and the address is read from a position the caller
# controls, so the throttle stops limiting anyone. Count only hops you operate.
# EASYCUSTOMS_TRUSTED_PROXY_HOPS=1

# ---- Connection pool + request concurrency (Postgres deployments) ---------
# These three move together and the app refuses to start if they contradict:
# THREADPOOL_MAX_THREADS must not exceed DB_POOL_SIZE + DB_MAX_OVERFLOW, because
# every one of those threads runs a request that wants a connection.
#
# They are per PROCESS, so the number that reaches the database is
#   (API tasks + worker tasks) x (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Check that against the server's max_connections — or, behind PgBouncer/RDS
# Proxy, against the POOLER's limit. Getting this wrong does not show up as a
# slow query; it shows up as "sorry, too many clients already" the first time
# the worker fleet scales up under load.
# EASYCUSTOMS_DB_POOL_SIZE=10
# EASYCUSTOMS_DB_MAX_OVERFLOW=30
# EASYCUSTOMS_DB_POOL_RECYCLE_SECONDS=1800
# EASYCUSTOMS_DB_POOL_PRE_PING=true
# EASYCUSTOMS_THREADPOOL_MAX_THREADS=40
#
# How long a review/finalize waits for another change to the SAME job.
# 0 (default) waits forever, which is what the old in-process lock did. Set it
# on a real deployment so a wedged request surfaces as an error the reviewer can
# act on instead of a page that never returns. Size it above your slowest
# legitimate finalize.
# EASYCUSTOMS_JOB_LOCK_TIMEOUT_SECONDS=120

# ---- Queue mode (async extraction over AWS SQS) ---------------------------
# off (default): POST /extract runs OCR+LLM inside the API request, as always.
# sqs: the endpoint claims the document and enqueues; backend/worker.py (run
# separately, same .env) does the slow work.  Requires a database BOTH
# processes reach — Postgres, unless API and worker share one machine.
# Create the queue + its dead-letter queue (or audit the ones you already have)
# with: cd backend && python scripts/provision_sqs.py  (add --apply to write).
# Full deployment and verification notes: docs/queue-deployment.md
# EASYCUSTOMS_QUEUE_PROVIDER=sqs
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/customs-processing-queue
# AWS_REGION=ap-south-1
# Credentials: prefer an EC2/ECS instance role (boto3 finds it by itself); on a
# dev machine, the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env pair.
# Worker tuning (defaults shown): concurrent extractions per worker process,
# and the heartbeat that keeps an in-flight message invisible to other workers.
# EASYCUSTOMS_WORKER_CONCURRENCY=4
# EASYCUSTOMS_SQS_HEARTBEAT_SECONDS=120
# EASYCUSTOMS_SQS_VISIBILITY_EXTEND_SECONDS=600

# ---- Declaration constants ------------------------------------------------
EASYCUSTOMS_DEFAULT_EXCHANGE_RATE=145.76

# ---- Rule-set flags (see ADR table in README) -----------------------------
# ADR-003 RESOLVED 2026-07-21 in favour of 0.7 — every item in the reference
# declaration satisfies Net = 0.7 x Gross (1.064 = 0.7 x 1.52).  0.7 is the code
# default; this line only restates it.  Setting 0.3 here (the pre-resolution
# value that used to ship in this file) silently understates the net weight of
# every ratio-derived item.  See docs/allocation-spec.md section 5.
EASYCUSTOMS_DEFAULT_NET_TO_GROSS_RATIO=0.7
EASYCUSTOMS_PAIR_DIVIDE_BY_TWO=true             # ADR-004 (rule divides PCS/2 for PR/NPR)
EASYCUSTOMS_COST_ALLOCATION_BASIS=value         # value (sample) | gross_weight (rule)
EASYCUSTOMS_DEFAULT_UNKNOWN_PAYMENT_TERMS_TO_LC=false   # ADR-006 (never silently default)
